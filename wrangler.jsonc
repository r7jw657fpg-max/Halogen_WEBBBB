{
  "name": "halogen-web",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/admin/*", "/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "halogen-db",
      "database_id": "cd9e095e-b708-4b91-a4ee-16decee3c3da"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "halogen-media"
    }
  ],
  "vars": {
    "ADMIN_USER": "admin"
  }
  // ADMIN_PASS wird NICHT hier eingetragen, sondern als Secret gesetzt:
  // npx wrangler secret put ADMIN_PASS
}
